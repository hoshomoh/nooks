{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Path alias. No baseUrl: TypeScript 6 deprecates it, and relative
       path patterns work without one. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting — STANDARDS.md requires strict types on every signature */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /* Off: protobuf-es generates TypeScript enums, and @nooks/api is consumed from
       source. The generated files are not ours to change, and an enum is the right
       shape for a proto enum. */
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
