# Reference clone of usememos/memos — read-only, never edited, never shipped.
reference/

# Dependencies
node_modules/

# Build output
apps/web/dist/
/nook

# The SPA that `pnpm --filter @nook/web release` bakes into the binary. The
# placeholder is tracked so //go:embed still compiles on a fresh clone.
server/router/frontend/dist/*
!server/router/frontend/dist/index.html

# Local data — a Nook instance keeps its SQLite file here during development
*.db
*.db-shm
*.db-wal
/data/

# Machine-specific Claude Code settings (PATH for this machine's toolchain)
.claude/settings.local.json

# Downloaded toolchain archives
go*.linux-amd64.tar.gz

# Editors and OS
.DS_Store
.idea/
.vscode/
