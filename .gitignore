# Read-only prior-art clones and local working notes. Never edited, never shipped.
reference/
.local/

# Dependencies
node_modules/

# Build output
apps/web/dist/
/nooks

# The SPA that `pnpm --filter @nooks/web release` bakes into the binary. The
# placeholder is tracked so //go:embed still compiles on a fresh clone.
server/router/frontend/dist/*
!server/router/frontend/dist/index.html

# Local data — a Nooks instance keeps its SQLite file here during development
*.db
*.db-shm
*.db-wal
/data/

# Machine-specific editor and tooling settings
.claude/

# Downloaded toolchain archives
go*.linux-amd64.tar.gz

# Editors and OS
.DS_Store
.idea/
.vscode/

# The checkout ./scripts/preflight.sh verifies a commit in.
.preflight/
